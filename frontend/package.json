		"clsx": "^2.1.1",
		"dexie": "^4.3.0",
		"lucide-vue-next": "^0.575.0",
		"pinia": "^2.1.7",
		"radix-vue": "^1.9.17",
		"tailwind-merge": "^3.5.0",
		"tailwindcss-animate": "^1.0.7",
		"vue": "^3.4.21",
		"vue-router": "^4.3.0",
		"vue-sonner": "^1.1.2",
		"workbox-window": "^7.4.0"
	},
	"devDependencies": {
		"@types/node": "^25.3.3",
		"@vitejs/plugin-vue": "^5.0.4",
		"@vue/test-utils": "^2.4.6",
		"autoprefixer": "^10.4.19",
		"jsdom": "^27.2.0",
		"postcss": "^8.4.38",
		"tailwindcss": "^3.4.3",
		"typescript": "^5.9.3",
		"vite": "^5.2.8",

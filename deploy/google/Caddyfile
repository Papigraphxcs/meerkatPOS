meerkatpos.me, www.meerkatpos.me {
    root * /srv/website
    encode zstd gzip
    file_server
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
}

demo.meerkatpos.me {
    encode zstd gzip
    reverse_proxy frontend:8080
    header X-Content-Type-Options nosniff
}
